    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <!-- 测试取证用：issues/141 G2 的②③档（重复抄送不重置未读、不刷原行时间）必须读内存仓储的
